# Copy to .env for local development. Never commit .env.

# --- Local development: individual DB settings ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=support_desk

# --- Production: one connection string (turns on SSL). Leave unset locally. ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=3001
NODE_ENV=development
